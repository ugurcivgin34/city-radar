{
  "name": "city-radar-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --ci",
    "test:tooling": "node --test tooling/tests/",
    "check:forbidden": "node tooling/forbidden.mjs",
    "export:android": "expo export --platform android --output-dir dist"
  },
  "dependencies": {
    "@expo/log-box": "^57.0.4",
    "@expo/metro-runtime": "~57.0.16",
    "expo": "57.0.26",
    "expo-constants": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
