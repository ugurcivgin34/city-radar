<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Primary zero-test guarantee (plan 0001 amendment 2): zero tests exits 8/9, which an
         injected "ignore exit code 8" setting cannot turn green. -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --minimum-expected-tests 1</TestingPlatformCommandLineArguments>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CityRadar.Shared\CityRadar.Shared.csproj" />
    <ProjectReference Include="..\..\src\CityRadar.Parking\CityRadar.Parking.csproj" />
    <ProjectReference Include="..\..\src\CityRadar.Traffic\CityRadar.Traffic.csproj" />
    <ProjectReference Include="..\..\src\CityRadar.Infrastructure\CityRadar.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\CityRadar.Api\CityRadar.Api.csproj" />
  </ItemGroup>
</Project>
