#!/bin/sh
# City Radar security check — dependency vulnerability scanning (docs/security.md).
# Separate from scripts/check on purpose: a vulnerability-database/registry outage must not look
# like a test failure. CI runs both. Each part SKIPs visibly until its project exists.
# Exceptions are never silent ignores: they need a reasoned, ideally time-boxed decision/ADR.
set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT" || exit 1
failed=0

echo "==> nuget-vulnerabilities"
if [ -f backend/CityRadar.slnx ]; then
  # `dotnet package list` is the .NET 10 SDK syntax; it exits 0 even when it finds
  # vulnerabilities, so the output is inspected. Re-check the syntax when the SDK pin changes.
  if out=$(dotnet package list --project backend/CityRadar.slnx --vulnerable --include-transitive 2>&1); then
    echo "$out"
    if echo "$out" | grep -qi "has the following vulnerable packages"; then
      echo "SECURITY: vulnerable NuGet packages found" >&2
      failed=1
    fi
  else
    echo "$out"
    echo "SECURITY-CHECK INFRA FAILURE: NuGet vulnerability scan could not run" >&2
    failed=1
  fi
else
  echo "SKIP: backend/CityRadar.slnx yok"
fi

echo "==> npm-audit"
if [ -f mobile/package.json ]; then
  # high/critical vulnerabilities in production dependencies fail the check.
  if ! (cd mobile && npm audit --omit=dev --audit-level=high); then
    echo "SECURITY: npm audit reported high/critical production vulnerabilities (or audit could not run)" >&2
    failed=1
  fi
else
  echo "SKIP: mobile/package.json yok"
fi

if [ "$failed" -ne 0 ]; then
  echo "SECURITY CHECK FAILED" >&2
  exit 1
fi
echo "SECURITY CHECK GREEN"
