#!/bin/sh
# City Radar security check — dependency vulnerability scanning (docs/security.md).
# Separate from scripts/check on purpose: a vulnerability-database/registry outage must not look
# like a test failure. CI runs both. The NuGet part never SKIPs (spec 0001); the npm part SKIPs
# visibly until the mobile project exists.
# Exceptions are never silent ignores: they need a reasoned, ideally time-boxed decision/ADR.
set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT" || exit 1
failed=0
# No .NET CLI / test-platform telemetry (docs/security.md, minimum data; review F-6).
export DOTNET_CLI_TELEMETRY_OPTOUT=1 TESTINGPLATFORM_TELEMETRY_OPTOUT=1

echo "==> nuget-vulnerabilities"
# Fail-closed, three outcomes (spec 0001 AC-13): no vulnerabilities -> GREEN; vulnerabilities ->
# RED; advisory/registry unreachable or unreadable output -> RED labelled as an infra failure.
# `dotnet package list` exits 0 even when it finds vulnerabilities, so its JSON is parsed by
# scripts/nuget-audit.cs. Commands run inside backend/ so backend/global.json pins the SDK.
# `dotnet package list` is the .NET 10 SDK syntax; re-check it when the SDK pin changes.
# The advisory query gets a fresh, empty NuGet HTTP cache every run: a warm cache would answer
# offline and could pass a run whose advisory source is unreachable (fail-open).
nuget_json=$(mktemp)
nuget_err=$(mktemp)
nuget_cache=$(mktemp -d)
if ! (cd backend && dotnet restore CityRadar.slnx >"$nuget_err" 2>&1); then
  cat "$nuget_err"
  echo "SECURITY INFRA FAILURE: dotnet restore failed (registry unreachable?)" >&2
  failed=1
else
  (cd backend && NUGET_HTTP_CACHE_PATH="$nuget_cache" dotnet package list --project CityRadar.slnx --vulnerable --include-transitive --format json >"$nuget_json" 2>"$nuget_err")
  list_exit=$?
  cat "$nuget_err"
  (cd backend && dotnet run --file ../scripts/nuget-audit.cs -- "$nuget_json" "$list_exit")
  case $? in
    0) ;;
    3) echo "SECURITY: vulnerable NuGet packages found" >&2; failed=1 ;;
    *) echo "SECURITY INFRA FAILURE: NuGet vulnerability audit could not complete" >&2; failed=1 ;;
  esac
fi
rm -rf "$nuget_json" "$nuget_err" "$nuget_cache"

echo "==> npm-audit"
if [ -f mobile/package.json ]; then
  # high/critical vulnerabilities in production dependencies fail the check.
  if ! (cd mobile && npm audit --omit=dev --audit-level=high); then
    echo "SECURITY: npm audit reported high/critical production vulnerabilities (or audit could not run)" >&2
    failed=1
  fi
else
  echo "SKIP: mobile/package.json yok"
fi

if [ "$failed" -ne 0 ]; then
  echo "SECURITY CHECK FAILED" >&2
  exit 1
fi
echo "SECURITY CHECK GREEN"
